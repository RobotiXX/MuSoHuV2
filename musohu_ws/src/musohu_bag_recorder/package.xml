<?xml version="1.0"?>
<package format="3">
  <name>musohu_bag_recorder</name><version>0.1.0</version>
  <description>MuSoHu C++ recording, adapted from ScoutMini rwd_bag_recorder.</description>
  <maintainer email="musohu@example.com">MuSoHu Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <build_depend>nlohmann-json-dev</build_depend>
  <depend>rclcpp</depend><depend>std_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>rosbag2_cpp</depend><depend>rosbag2_storage</depend>
  <depend>rosbag2_transport</depend><depend>rosbag2_compression</depend>
  <depend>yaml_cpp_vendor</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>

