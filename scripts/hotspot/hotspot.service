[Unit]
Description=Start Robotixx_MuSoHu WiFi Hotspot at boot
After=network-online.target NetworkManager.service
Wants=network-online.target NetworkManager.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 10
ExecStart="HOTSPOT_SCRIPT_PLACEHOLDER"
RemainAfterExit=yes
User=root
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
