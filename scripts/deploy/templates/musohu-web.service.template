[Unit]
Description=MuSoHu Web Service for Script Management
Documentation=https://github.com/RobotiXX/MuSoHuV2
After=network-online.target musohu-zenoh.service
Requires=musohu-zenoh.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=USER_PLACEHOLDER
Group=GROUP_PLACEHOLDER
WorkingDirectory=WEB_APP_DIR_PLACEHOLDER
Environment="PATH=WEB_APP_DIR_PLACEHOLDER/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONNOUSERSITE=1"
Environment="MUSOHU_WORKSPACE=WORKSPACE_PLACEHOLDER"
Environment="ROS_LOCALHOST_ONLY=1"
Environment="RMW_IMPLEMENTATION=rmw_zenoh_cpp"
Environment="RMW_FASTRTPS_PUBLICATION_MODE=ASYNCHRONOUS"

# Main process - Run with uvicorn ASGI server
ExecStart="WEB_APP_DIR_PLACEHOLDER/venv/bin/python" -m uvicorn app:app --workers 1 --host 0.0.0.0 --port PORT_PLACEHOLDER

# Restart Configuration - Always restart on failure
Restart=on-failure
RestartSec=10

# Start limit configuration - No limit on restart attempts
StartLimitBurst=0

# Watchdog configuration (optional - requires systemd notify support)
# WatchdogSec=30

# Security hardening (optional)
# Offline phone sync uses narrowly permitted sudo date / set-ntp commands.
NoNewPrivileges=false
PrivateTmp=true

# The service owns ROS launches and rosbag children. Limits include the whole
# cgroup; the old 256 MB / 25% CPU limits cannot support the sensor stack.
MemoryHigh=3G
MemoryMax=5G
CPUWeight=100
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=1900

# Logging - All logs go to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=musohu-web

# Working directory permissions
UMask=0022

[Install]
WantedBy=multi-user.target
